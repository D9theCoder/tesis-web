# Absolute path to the Python TESIS repository whose results/ the observer reads.
# This process NEVER writes to it and never exposes credentials from it.
TESIS_ROOT=/home/kevin/coding/tesis

# Poll interval for the live dashboard, in milliseconds.
NEXT_PUBLIC_TESIS_POLL_MS=2000

# Port for the local dev server.
PORT=3000

# Optional named server-only roots (JSON objects; absolute paths).
# Setting artifact roots replaces the default TESIS_ROOT/results/runs root.
# Include "runs" explicitly if you also want normal runs.
# TESIS_ARTIFACT_ROOTS='{"runs":"/home/kevin/coding/tesis/results/runs","epoch7":"/home/kevin/coding/tesis/results/validation/scoring-v4-remediation-2026-10-12-matrix-epoch7"}'
# TESIS_REVIEW_ROOTS='{"epoch1":"/home/kevin/coding/tesis/results/validation/scoring-v4-remediation-2026-10-12-matrix-epoch7/ai-review-epoch1","epoch2":"/home/kevin/coding/tesis/results/validation/scoring-v4-remediation-2026-10-12-matrix-epoch7/ai-review-epoch2","epoch3":"/home/kevin/coding/tesis/results/validation/scoring-v4-remediation-2026-10-12-matrix-epoch7/ai-review-epoch3"}'

# Optional pre-generated observer-projection.v1 exports (JSON array).
# Root identifiers must match the producer's source/review root identifiers.
# Every referenced source hash is verified. The web observer never runs the exporter.
# TESIS_PROJECTION_FILES='["/home/kevin/coding/tesis/results/validation/artifact-export-2026-10-12/observer-epoch7-accepted.json"]'

# Compatibility mode when no producer projection is selected:
# TESIS_COMPATIBILITY_FILES='["/home/kevin/coding/tesis/results/validation/execution-security-status-2026-10-12-review/historical-compatibility.json"]'
# Legacy pending review statuses need explicit current-epoch source/ledger associations.
# TESIS_REVIEW_INDEX_FILES='["/home/kevin/coding/tesis/results/validation/scoring-v4-remediation-2026-10-12-matrix-epoch7/ai-review-audit-v2.json"]'
